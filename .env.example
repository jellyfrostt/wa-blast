PORT=3001
LOG_LEVEL=info

# SQLite file. On Railway this points into the mounted volume.
# DB_PATH=./data/wa-blast.db

# Maximum WhatsApp numbers that can be added.
# MAX_SESSIONS=10

# Daily database snapshots to keep (0 disables them).
# BACKUP_KEEP=7

# Set to enable GET /api/backup (send it as "Authorization: Bearer <token>").
# BACKUP_TOKEN=

# Set to enable customer-intent analysis with Claude. Conversations are sent to Anthropic's API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# INSIGHT_CONTEXT=

# Login. Off unless AUTH_ENABLED=true.
# AUTH_ENABLED=true
# First admin as a password account (the password must be changed at first login):
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Google sign-in for one Workspace domain. Redirect URI to register: <PUBLIC_URL>/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ALLOWED_DOMAIN=pintarnya.com
# ADMIN_EMAILS=
# PUBLIC_URL=
